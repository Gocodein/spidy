# ============================================================
#  DETECTOR AI — .gitignore
#  Endangered Species Detection & Tracking System (9 Classes)
#  
#  Project structure to TRACK:
#    .gitignore, readme.md, requirements.txt
#    project_guide.md, project_checklist.md
#    run_detector.py
#    detector_ai/        (core pipeline — 9 modules)
#    training/           (dataset setup & model training scripts)
#    dashboard/app.py    (Streamlit monitoring dashboard)
# ============================================================

# ─────────────────────────── Python ─────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl
*.so
*.pyd

# ─────────────────── Virtual Environments ───────────────────
.venv*/
venv/
env/
ENV/

# ─────────────────── Model Weights (large) ──────────────────
# Trained locally — download from release or retrain
models/*.pt
models/*.pth
models/*.onnx
models/*.engine
models/*.tflite
# Pretrained weights in root
yolov8n.pt
yolo26n.pt

# ──────────────────── Datasets (large) ──────────────────────
# Recreate via: python training/fill_dataset_gaps.py
# Total: ~4.3 GB images + labels + crops + raw downloads
multispecies_dataset/
tiger_dataset/

# ──────────────────── Video Outputs (large) ─────────────────
*.mp4
*.avi
*.mkv
*.mov

